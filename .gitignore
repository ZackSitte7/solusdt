# ---- 环境 / 依赖 ----
.venv/
venv/
env/
node_modules/
target/
dist/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- 数据 / 产物(默认不入库, 可用脚本重新生成) ----
data/
reports/
*.parquet
*.csv
*.png

# ---- 例外: SOL/USDT 4h 币安/欧易原始数据随仓库分发(见 src/data_fetch.py) ----
!data/
!data/solusdt_4h_raw_binance.parquet
!data/solusdt_4h_raw_okx.parquet
!data/solusdt_4h_okx_raw.json
!data/solusdt_4h_clean.parquet
!data/solusdt_4h_clean_okx.parquet

# ---- 例外: 回测报告随仓库分发(见 run_backtest_okx.py / _v2.py / _v3.py) ----
!reports/
!reports/**/*.md
!reports/**/*.json
!reports/**/*.csv
!reports/**/*.png

# ---- 排除: v8/v9 的"配置×子折"原始网格转储 ----
# 每个文件 ~108MB, 超出 GitHub 单文件 100MB 硬上限(会被拒绝推送);
# 且可由 run_backtest_v8.py / run_backtest_v9.py 重新生成, 故不入库。
reports/**/selection_folds_*.csv

# ---- 敏感信息: 一律不得入库 ----
.env
.env.*
*.key
*_key
*_key.txt
secrets/
credentials*
config.local.*
*.pem
*.p12

# ---- 系统 ----
.DS_Store
*.log
