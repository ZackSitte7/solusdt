# ============================================================ .gitignore
# 设计原则: **代码与文档入库, 可从脚本再生的大体量中间产物出库**;
#          但报告类产物(metrics/report/图/成交明细)随仓库分发, 便于复现与对比。

# ---- 环境 / 依赖 ----
.venv/
venv/
env/
node_modules/
dist/
build/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---- 数据 / 大体量产物(默认出库, 可由脚本重新生成) ----
data/
reports/
*.parquet
*.csv
*.png

# ---- 例外: SOL/USDT 4h 币安/欧易原始数据随仓库分发(见 src/data_fetch.py) ----
!data/
!data/solusdt_4h_raw_binance.parquet
!data/solusdt_4h_raw_okx.parquet
!data/solusdt_4h_okx_raw.json
!data/solusdt_4h_clean.parquet
!data/solusdt_4h_clean_okx.parquet

# ---- 例外: 回测报告随仓库分发(见 run_backtest_okx.py / _v2.py ... / _v10.py) ----
!reports/
!reports/**/*.md
!reports/**/*.json
!reports/**/*.csv
!reports/**/*.png

# ---- 出库: v8/v9 的"配置×子折"原始网格转储 ----
# 单文件约 108MB, 超过 GitHub 单文件 100MiB 硬上限, 直接推送会被拒绝;
# 且可由 run_backtest_v8.py / run_backtest_v9.py 重新生成, 故原文件不入库。
reports/**/selection_folds_*.csv

# ---- 出库: v15 实验的"原始网格转储"(单文件 29~83MB, 可由 tools/exp_*.py 重新生成) ----
# exp_gate_raw.csv(78MB) / v15_gate_grid.csv(83MB) / v15_tpext_grid.csv(29MB) —— 逐 (门控×模型×执行)
# 的全量明细; 汇总结论已随 *_summary.csv 入库, 全量明细不入库。
reports/**/exp_gate_raw.csv
reports/**/v15_gate_grid.csv
reports/**/v15_tpext_grid.csv

# ---- 入库: 上述大文件的分片 ----
# 由 tools/shards.py 按行边界切成 partNN(每片 <=90MiB, 每片重复表头可独立读取),
# 附 MANIFEST.json(逐片 sha256/行数)可校验与还原。还原: tools/shards.py merge
!reports/**/shards/
!reports/**/shards/**

# ---- 敏感信息: 一律不得入库 ----
.env
.env.*
*.key
*_key
*_key.txt
secrets/
credentials*
config.local.*
*.pem
*.p12

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
*.log
*.swp
.idea/
.vscode/
